package views

// Home es la landing completa.
templ Home(p Page) {
	@Layout(p) {
		@hero()
		@equipo()
		@sesion()
		@nosotros()
		@importante()
		@preguntas()
		@contacto(p.Form)
	}
}

templ hero() {
	<section class="hero" id="inicio">
		<div class="container hero__inner">
			<div class="hero__text reveal">
				<span class="tag">Esperanza, Santa Fe</span>
				<h1>SEDH 2000 <span class="hero__accent">en Esperanza</span></h1>
				<p class="hero__lead">
					Sesiones con el SEDH 2000, un equipo electromagnético de diseño y fabricación argentina.
					Te atiendo personalmente, de principio a fin.
				</p>
				<div class="hero__actions">
					<a href="#contacto" class="btn">Quiero coordinar una sesión</a>
					<a href="#sesion" class="btn btn--ghost">¿Cómo es una sesión?</a>
				</div>
			</div>
			<div class="hero__visual reveal">
				<div class="waves">
					<span></span><span></span><span></span><span></span>
				</div>
				<img class="hero__img" src="/img/sedh2000-equipo.jpg" alt="" fetchpriority="high"/>
			</div>
		</div>
	</section>
}

templ equipo() {
	<section class="section" id="equipo">
		<div class="container">
			<header class="section__head reveal">
				<span class="eyebrow">El equipo</span>
				<h2>Ingeniería electrónica hecha en casa</h2>
				<p>
					El SEDH 2000 se diseña y se fabrica en Rosario. Cada componente está pensado para que la
					sesión sea simple, cómoda y ajustada a cada persona.
				</p>
			</header>
			<div class="equipo">
				<figure class="equipo__photo reveal">
					<img src="/img/sedh2000-equipo.jpg" alt="Equipo SEDH 2000 completo: consola con panel de control sobre un pie con ruedas y las dos bobinas" loading="lazy"/>
					<figcaption>SEDH 2000</figcaption>
				</figure>
				<div class="cards">
					<article class="card reveal">
						<div class="card__icon" aria-hidden="true">
							<svg viewBox="0 0 24 24"><rect x="3" y="6" width="18" height="12" rx="2"></rect><path d="M7 10h4M7 14h2M15 10v4"></path></svg>
						</div>
						<h3>Tecnología nacional</h3>
						<p>Un equipo electrónico diseñado y fabricado en Argentina, que genera un barrido de frecuencias controlado.</p>
					</article>
					<article class="card reveal">
						<div class="card__icon" aria-hidden="true">
							<svg viewBox="0 0 24 24"><path d="M4 12c0-3 2-5 4-5s4 2 4 5-2 5-4 5-4-2-4-5zM12 12c0-3 2-5 4-5s4 2 4 5-2 5-4 5-4-2-4-5z"></path></svg>
						</div>
						<h3>Sin nada sobre la piel</h3>
						<p>Dos bobinas se ubican a la altura de los tobillos. No se usan electrodos ni agujas.</p>
					</article>
					<article class="card reveal">
						<div class="card__icon" aria-hidden="true">
							<svg viewBox="0 0 24 24"><circle cx="6" cy="12" r="3"></circle><circle cx="12" cy="12" r="3"></circle><circle cx="18" cy="12" r="3"></circle><path d="M6 9V5M12 9V5M18 9V5"></path></svg>
						</div>
						<h3>Ajustada a vos</h3>
						<p>Antes de empezar, configuro el equipo según tu peso, tu edad y tu contextura.</p>
					</article>
					<article class="card reveal">
						<div class="card__icon" aria-hidden="true">
							<svg viewBox="0 0 24 24"><path d="M4 14h16l-2 5H6z"></path><path d="M8 14c0-3 1-5 4-8 3 3 4 5 4 8"></path></svg>
						</div>
						<h3>Cómoda y tranquila</h3>
						<p>Te sentás, apoyás los pies en una batea con agua y solo tenés que relajarte.</p>
					</article>
				</div>
			</div>
			<!-- Panel de control: ajuste por persona -->
			<div class="panel reveal">
				<h3 class="panel__title">Una sesión a tu medida</h3>
				<div class="panel__grid">
					<div class="knob">
						<div class="knob__dial" data-knob="1" aria-hidden="true"><span></span></div>
						<h4>Tiempo</h4>
						<p>Según el peso corporal: de <strong>5 a 35 minutos</strong>.</p>
					</div>
					<div class="knob">
						<div class="knob__dial" data-knob="2" aria-hidden="true"><span></span></div>
						<h4>Edad</h4>
						<p>Ajusta la intensidad del barrido según la edad.</p>
					</div>
					<div class="knob">
						<div class="knob__dial" data-knob="3" aria-hidden="true"><span></span></div>
						<h4>Contextura</h4>
						<p>Ajusta la configuración según la composición corporal.</p>
					</div>
				</div>
			</div>
		</div>
	</section>
}

templ sesion() {
	<section class="section section--alt" id="sesion">
		<div class="container">
			<header class="section__head reveal">
				<span class="eyebrow">La sesión</span>
				<h2>¿Cómo es una sesión?</h2>
				<p>Simple, tranquila y acompañada de principio a fin.</p>
			</header>
			<ol class="steps">
				for _, s := range steps {
					<li class="step reveal">
						<span class="step__num">{ s.Num }</span>
						<h3>{ s.Title }</h3>
						<p>{ s.Text }</p>
					</li>
				}
			</ol>
			<div class="gallery">
				for _, ph := range gallery {
					<figure class="gallery__item reveal">
						<img src={ ph.Src } alt={ ph.Alt } loading="lazy"/>
					</figure>
				}
			</div>
			<div class="note reveal">
				<strong>Protocolo del fabricante:</strong> una sesión diaria durante un ciclo de 5 a 8 sesiones.
				Te lo explico en detalle en la charla previa.
			</div>
		</div>
	</section>
}

templ nosotros() {
	<section class="section" id="nosotros">
		<div class="container about">
			<div class="about__text reveal">
				<span class="eyebrow">Quién te atiende</span>
				<div class="about__person">
					<span class="about__monogram" aria-hidden="true">MT</span>
					<h2>Mariana Trionfini</h2>
				</div>
				<p>
					Soy de Esperanza y elegí el SEDH 2000 para ofrecer sesiones cerca de casa, con tiempo y
					atención personalizada. Cada sesión la acompaño yo, desde la charla previa hasta el final.
				</p>
			</div>
			<div class="about__stats reveal">
				<div class="stat"><strong>100%</strong><span>Fabricación nacional</span></div>
				<div class="stat"><strong>Esperanza</strong><span>Santa Fe, Argentina</span></div>
				<div class="stat"><strong>1 a 1</strong><span>Atención personalizada</span></div>
			</div>
		</div>
	</section>
}

templ importante() {
	<section class="section section--alt" id="importante">
		<div class="container">
			<div class="important reveal">
				<h2>Antes de reservar</h2>
				<p>Por indicación del fabricante, el equipo <strong>no se usa</strong> en:</p>
				<ul>
					<li>Niños menores de 6 años y adultos mayores de 85 años.</li>
					<li>Personas con enfermedades agudas o en curso.</li>
					<li>Personas con cuadros oncológicos.</li>
					<li>Personas bajo tratamiento psiquiátrico.</li>
				</ul>
				<p>
					Si usás marcapasos u otro dispositivo implantado, estás embarazada o tenés alguna duda,
					consultalo conmigo antes de coordinar.
				</p>
				<p class="important__disclaimer">
					El SEDH 2000 no es un tratamiento médico y no reemplaza el diagnóstico ni el tratamiento
					de un profesional de la salud. No suspendas ni modifiques ningún tratamiento indicado por tu médico.
				</p>
			</div>
		</div>
	</section>
}

templ preguntas() {
	<section class="section" id="preguntas">
		<div class="container container--narrow">
			<header class="section__head reveal">
				<span class="eyebrow">Preguntas frecuentes</span>
				<h2>Lo que más me consultan</h2>
			</header>
			<div class="faq" id="faq">
				for _, f := range faqs {
					<div class="faq__item reveal">
						<button class="faq__q" aria-expanded="false">{ f.Q }</button>
						<div class="faq__a"><p>{ f.A }</p></div>
					</div>
				}
			</div>
		</div>
	</section>
}

templ contacto(f FormState) {
	<section class="section section--dark" id="contacto">
		<div class="container contact">
			<div class="contact__info reveal">
				<span class="eyebrow eyebrow--light">Contacto</span>
				<h2>Coordiná tu sesión</h2>
				<p>Dejame tus datos y te respondo por WhatsApp. Sin compromiso: primero charlamos y después decidís.</p>
				<ul class="contact__list">
					<li><span>WhatsApp</span><a id="waDirect" href={ templ.SafeURL(waDefault()) } target="_blank" rel="noopener">{ waLabel() }</a></li>
					<li><span>Instagram</span><a id="igDirect" href={ templ.SafeURL(igURL()) } target="_blank" rel="noopener">{ igHandle() }</a></li>
					<li><span>Ubicación</span><p>Esperanza, Santa Fe. Dirección al coordinar.</p></li>
				</ul>
			</div>
			<!-- El reveal va en el contenedor: htmx reemplaza solo el formulario de adentro. -->
			<div class="reveal">
				@ContactForm(f)
			</div>
		</div>
	</section>
}
