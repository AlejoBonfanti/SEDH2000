package views

import "strconv"

const siteURL = "https://sedh-2000.vercel.app/"
const title = "SEDH 2000 en Esperanza | Mariana Trionfini"
const description = "Sesiones con el SEDH 2000 en Esperanza, Santa Fe. Conocé cómo es una sesión y coordiná la tuya con Mariana."

// Layout es el esqueleto HTML: <head>, header, footer y botón flotante.
templ Layout(p Page) {
	<!DOCTYPE html>
	<html lang="es-AR">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<script>
				// Con JS activo se habilitan animaciones, acordeón y menú móvil.
				// Si app.js no llega a cargar en 4 s, se vuelve a la versión sin JS (todo visible).
				document.documentElement.classList.add("js");
				setTimeout(function () {
					if (!document.documentElement.dataset.ready)
						document.documentElement.classList.remove("js");
				}, 4000);
			</script>
			<title>{ title }</title>
			<meta name="description" content={ description }/>
			<link rel="canonical" href={ siteURL }/>
			<meta name="theme-color" content="#0b1524"/>
			<!-- Favicon -->
			<link rel="icon" href="/favicon.ico" sizes="any"/>
			<link rel="icon" href="/favicon.svg" type="image/svg+xml"/>
			<link rel="apple-touch-icon" href="/apple-touch-icon.png"/>
			<!-- Open Graph: vista previa al compartir el link (WhatsApp, Facebook, etc.) -->
			<meta property="og:type" content="website"/>
			<meta property="og:locale" content="es_AR"/>
			<meta property="og:site_name" content="SEDH 2000"/>
			<meta property="og:title" content={ title }/>
			<meta property="og:description" content={ description }/>
			<meta property="og:url" content={ siteURL }/>
			<meta property="og:image" content={ siteURL + "og.jpg" }/>
			<meta property="og:image:type" content="image/jpeg"/>
			<meta property="og:image:width" content="1200"/>
			<meta property="og:image:height" content="630"/>
			<meta property="og:image:alt" content="Sesiones con el SEDH 2000 en Esperanza, Santa Fe"/>
			<meta name="twitter:card" content="summary_large_image"/>
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
			<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet"/>
			<link rel="stylesheet" href="/css/main.css"/>
			<script defer src="/js/htmx.min.js"></script>
			<script defer src="/js/app.js"></script>
			if p.Analytics {
				<!-- Vercel Web Analytics (reemplaza a @vercel/analytics) -->
				<script>
					window.va =
						window.va ||
						function () {
							(window.vaq = window.vaq || []).push(arguments);
						};
				</script>
				<script defer src="/_vercel/insights/script.js"></script>
			}
		</head>
		<body>
			@header()
			<main>
				{ children... }
			</main>
			@footer(p.Year)
			<a class="wa-float" id="waFloat" href={ templ.SafeURL(waDefault()) } target="_blank" rel="noopener" aria-label="Escribime por WhatsApp">
				<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.4.8 3.2.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3z"></path></svg>
			</a>
		</body>
	</html>
}

templ header() {
	<header class="header" id="header">
		<div class="container header__inner">
			<a href="#inicio" class="logo" aria-label="SEDH 2000, ir al inicio">
				<span class="logo__mark" aria-hidden="true"></span>
				<span>SEDH <strong>2000</strong></span>
			</a>
			<button class="nav-toggle" id="navToggle" aria-label="Abrir menú" aria-expanded="false" aria-controls="nav">
				<span></span><span></span><span></span>
			</button>
			<nav class="nav" id="nav">
				<a href="#equipo">El equipo</a>
				<a href="#sesion">La sesión</a>
				<a href="#nosotros">Quién te atiende</a>
				<a href="#preguntas">Preguntas</a>
				<a href="#contacto" class="btn btn--small">Coordinar sesión</a>
			</nav>
		</div>
	</header>
}

templ footer(year int) {
	<footer class="footer">
		<div class="container footer__inner">
			<p><strong>SEDH 2000 en Esperanza</strong> · Mariana Trionfini · <a href={ templ.SafeURL(igURL()) } target="_blank" rel="noopener">{ igHandle() }</a></p>
			<p class="footer__small">Equipo fabricado por Patagonia Instrumental · Industria Argentina</p>
			<p class="footer__small">
				El SEDH 2000 no es un tratamiento médico ni reemplaza la consulta con un profesional de la salud.
			</p>
			<p class="footer__small">© <span id="year">{ strconv.Itoa(year) }</span> alejo bonfanti</p>
		</div>
	</footer>
}
